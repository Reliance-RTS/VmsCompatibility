;;; <summary>
;;; Returns the number of days since November 17, 1858.
;;; DAY_TIME is a VMS absolute timestamp in 100-nanosecond units.
;;; </summary>
;;; <param name="number_of_days"></param>
;;; <param name="day_time"></param>
;;; <returns></returns>
function LIB$DAY                        ,^val
	req out %ref(number_of_days)    ,int
	req in  %ref(user_time)		,long
.ifndef dblnet
	opt out %ref(day_time)		,int
.endc	
	endparams
proc
.ifndef dblnet
	if ^passed(day_time)
		throw new ApplicationException("Not implemented!")
.endc	
	number_of_days = user_time / 864000000000
	freturn 1				; SS$_NORMAL
endfunction

